{
  "name": "idbi/blackbox",
  "description": "Request tracing and audit trail for Laravel: request id, client session, who, payload and headers, written after the response is sent.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/idbi/blackbox",
  "support": {
    "issues": "https://github.com/idbi/blackbox/issues",
    "source": "https://github.com/idbi/blackbox"
  },
  "keywords": [
    "laravel",
    "audit",
    "audit-log",
    "tracing",
    "request-id",
    "logging",
    "loki",
    "openreplay"
  ],
  "require": {
    "php": "^8.1",
    "ext-mbstring": "*",
    "illuminate/auth": "^8.49|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^8.49|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/log": "^8.49|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/queue": "^8.49|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^8.49|^9.0|^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.13",
    "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0"
  },
  "suggest": {
    "sentry/sentry-laravel": "Tags Sentry events with the request id and session id."
  },
  "autoload": {
    "psr-4": {
      "Blackbox\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Blackbox\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "coverage": "phpunit --coverage-filter src --coverage-text",
    "lint": "pint --test",
    "format": "pint"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Blackbox\\BlackboxServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
